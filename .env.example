# ========================================
# Docker イメージタグ
# ========================================
# dev 環境: dev / 本番環境: latest (デフォルト)
IMAGE_TAG=latest

# ========================================
# データベース
# ========================================
DB_USER=omutsu
DB_PASSWORD=changeme

# ========================================
# 認証 (Auth.js / NextAuth)
# ========================================
# openssl rand -base64 32 で生成
NEXTAUTH_SECRET=
# ローカル: http://localhost:3000 / 本番: https://diaperlicense.online
NEXTAUTH_URL=https://diaperlicense.online

# ========================================
# OAuth プロバイダー
# ========================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================================
# Supabase Realtime (Broadcast専用)
# ========================================
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ========================================
# Discord Bot (DM通知用)
# ========================================
DISCORD_BOT_TOKEN=

# ========================================
# Garage (S3互換ストレージ)
# ========================================
# openssl rand -hex 32 で生成
GARAGE_RPC_SECRET=
# Garage セットアップ後に発行するアクセスキー
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=icons

# ========================================
# GitHub Actions Secrets (CI/CD用)
# ========================================
# 以下は .env ファイルには記載せず、
# GitHub リポジトリの Settings > Environments に environment を作成し
# それぞれに Secrets を登録する
#
# Environment: dev  (develop ブランチのデプロイ先)
#   VPS_HOST    : 開発VPSのIPアドレスまたはホスト名
#   VPS_USER    : SSH接続ユーザー名 (例: ubuntu, deploy)
#   VPS_SSH_KEY : SSH秘密鍵 (ssh-keygen で生成、公開鍵をVPSの authorized_keys に登録)
#
# Environment: prod   (main ブランチのデプロイ先)
#   VPS_HOST    : 本番VPSのIPアドレスまたはホスト名
#   VPS_USER    : SSH接続ユーザー名
#   VPS_SSH_KEY : SSH秘密鍵
#
# GITHUB_TOKEN は Actions が自動で提供するため登録不要
